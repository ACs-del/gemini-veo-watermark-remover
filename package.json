{
  "name": "gemini-veo-watermark-remover",
  "version": "0.1.0",
  "description": "Remove Gemini image and Veo video watermarks using mathematically precise reverse alpha blending. 100% client-side, open source.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./node": "./dist/node.js",
    "./gemini": "./dist/gemini.js"
  },
  "bin": {
    "vwr": "./bin/vwr.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "src/extension/",
    "src/userscript/"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test tests/"
  },
  "keywords": [
    "gemini",
    "veo",
    "watermark",
    "remover",
    "image",
    "video",
    "webcodecs",
    "reverse-alpha-blending",
    "chrome-extension",
    "userscript"
  ],
  "license": "MIT",
  "author": "ACs-del",
  "homepage": "https://removegeminiwatermark.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ACs-del/gemini-veo-watermark-remover"
  },
  "bugs": {
    "url": "https://github.com/ACs-del/gemini-veo-watermark-remover/issues"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "mp4-muxer": "^5.1.3",
    "mp4box": "^0.5.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
