{
  "name": "@vylio/gemini-veo-watermark-remover",
  "version": "0.1.0",
  "description": "Remove Gemini 3.5+/legacy image watermarks and Veo video watermarks locally with reverse alpha blending. Browser, CLI, SDK, extension, userscript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./gemini": {
      "types": "./dist/gemini.d.ts",
      "import": "./dist/gemini.js"
    }
  },
  "bin": {
    "vwr": "bin/vwr.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "src/extension/",
    "src/userscript/"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "gemini",
    "veo",
    "watermark",
    "remover",
    "image",
    "video",
    "webcodecs",
    "reverse-alpha-blending",
    "chrome-extension",
    "userscript"
  ],
  "license": "MIT",
  "author": "ACs-del",
  "homepage": "https://vylio.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACs-del/gemini-veo-watermark-remover.git"
  },
  "bugs": {
    "url": "https://github.com/ACs-del/gemini-veo-watermark-remover/issues"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "mp4-muxer": "^5.1.3",
    "mp4box": "^0.5.4"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
